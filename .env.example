# Local Postgres — use either this block…
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=gocentral

# …or a single URL (Neon / Vercel). DATABASE_URL wins if set.
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# GoCentral REST API base URL (no trailing slash)
GOCENTRAL_API_BASE_URL=http://localhost:9103
